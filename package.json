{
  "name": "versionist-dev-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Versionist development workspace",
  "author": "Versionist contributors",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm run build:admin && wp-env run wordpress --env-cwd=wp-content/plugins/versionist php bin/build-release.php \"$(git describe --tags --always)\" && mkdir -p dist && mv plugins/versionist/dist/*.zip dist/",
    "build:admin": "pnpm --filter versionist-admin-ui run build",
    "changelog": "node -r ./scripts/node_modules/ts-node/register scripts/changelog.ts",
    "env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "destroy": "wp-env destroy",
    "composer": "wp-env run wordpress --env-cwd=wp-content/plugins/versionist composer",
    "wp": "wp-env run cli wp",
    "lint": "pnpm run lint:php && pnpm run lint:js && pnpm run lint:markdown",
    "lint:php": "wp-env run wordpress --env-cwd=wp-content/plugins/versionist vendor/bin/phpcs",
    "lint:php:fix": "wp-env run wordpress --env-cwd=wp-content/plugins/versionist vendor/bin/phpcbf",
    "lint:js": "pnpm --filter versionist-admin-ui run lint && pnpm --filter versionist-admin-ui run typecheck",
    "lint:markdown": "markdownlint -i '{**/vendor/**,**/node_modules/**}' .",
    "analyse": "wp-env run wordpress --env-cwd=wp-content/plugins/versionist vendor/bin/phpstan analyse --memory-limit=1G",
    "test": "pnpm run phpunit --testsuite Unit,StorageTests,GitRepositoryTests",
    "test:unit": "pnpm run phpunit --testsuite Unit",
    "test:env": "wp-env start --config=.wp-env.test.json",
    "test:wp": "wp-env run --config=.wp-env.test.json wordpress --env-cwd=wp-content/plugins/versionist env VP_DIR=/var/www/html/wp-content/plugins/versionist vendor/bin/phpunit -c tests/phpunit.xml --testsuite End2End,SynchronizerTests,Workflow",
    "e2e:env": "wp-env start --config=.wp-env.e2e.json",
    "test:e2e": "pnpm --filter versionist-e2e run test",
    "test:js": "pnpm --filter versionist-admin-ui run test",
    "phpunit": "wp-env run wordpress --env-cwd=wp-content/plugins/versionist vendor/bin/phpunit -c tests/phpunit.xml"
  },
  "engines": {
    "node": ">= 24"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint"
    ]
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1"
  }
}
