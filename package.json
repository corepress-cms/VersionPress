{
  "name": "versionpress-dev-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "VersionPress development workspace",
  "author": "VersionPress",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prepare": "husky",
    "build": "node -r ./scripts/node_modules/ts-node/register scripts/build.ts",
    "build:frontend": "pnpm --filter versionpress-frontend run build && node -e \"require('fs').cpSync('frontend/build', 'plugins/versionpress/admin/public/gui', {recursive: true})\"",
    "changelog": "node -r ./scripts/node_modules/ts-node/register scripts/changelog.ts",
    "env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "destroy": "wp-env destroy",
    "composer": "wp-env run wordpress --env-cwd=wp-content/plugins/versionpress composer",
    "wp": "wp-env run cli wp",
    "lint": "pnpm run lint:php && pnpm run lint:markdown",
    "lint:php": "wp-env run wordpress --env-cwd=wp-content/plugins/versionpress vendor/bin/phpcs",
    "lint:php:fix": "wp-env run wordpress --env-cwd=wp-content/plugins/versionpress vendor/bin/phpcbf",
    "lint:markdown": "markdownlint -i '{**/vendor/**,**/node_modules/**}' .",
    "analyse": "wp-env run wordpress --env-cwd=wp-content/plugins/versionpress vendor/bin/phpstan analyse --memory-limit=1G",
    "test": "pnpm run phpunit --testsuite Unit,StorageTests,GitRepositoryTests",
    "test:unit": "pnpm run phpunit --testsuite Unit",
    "phpunit": "wp-env run wordpress --env-cwd=wp-content/plugins/versionpress vendor/bin/phpunit -c tests/phpunit.xml"
  },
  "engines": {
    "node": ">= 24"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint"
    ]
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1"
  }
}
