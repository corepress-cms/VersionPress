includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80500
    paths:
        - versionpress.php
        - bootstrap.php
        - setup-hooks.php
        - internal-functions.php
        - public-functions.php
        - uninstall.php
        - admin
        - src
        - .versionpress/hooks.php
    excludePaths:
        - admin/public
        # Test-only copy of WordPress 4.x wpdb and WP_Error; would shadow the real WordPress stubs.
        - tests/SynchronizerTests/Utils/WpdbCopy.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanDirectories:
        - vendor/wp-cli/wp-cli/php
    dynamicConstantNames:
        - VERSIONPRESS_TEMP_DIR
        - VERSIONPRESS_ACTIVATION_FILE
        - VERSIONPRESS_COMMIT_MESSAGE_PREFIX
        - VERSIONPRESS_GUI
        - VERSIONPRESS_REQUIRE_API_AUTH
        - VERSIONPRESS_ACTIVATED
        - VP_PROJECT_ROOT
        - VP_VPDB_DIR
        - VP_INDEX_DIR
        - VP_GIT_BINARY
        - VP_WP_CLI_BINARY
        - VP_DEACTIVATING
        - VP_DEBUG
        - VP_MAINTENANCE
        - VP_ENVIRONMENT
        - VP_ENVIRONMENT_TAG
        - VP_VERSION_TAG
        - DB_NAME
        - DB_USER
        - DB_PASSWORD
        - DB_HOST
