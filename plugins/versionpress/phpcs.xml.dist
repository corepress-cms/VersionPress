<?xml version="1.0"?>
<ruleset name="VersionPress">
    <description>PSR-12 formatting plus the WordPress security, i18n and database sniffs.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/log/*</exclude-pattern>
    <exclude-pattern>/temp/*</exclude-pattern>
    <exclude-pattern>/admin/public/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/vendor-prefixed/*</exclude-pattern>
    <!-- Developer tools, not part of the release (see .distignore) -->
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/src/Database/wpdb-api-to-phpdoc.php</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.5-"/>
    <config name="minimum_wp_version" value="7.1"/>

    <!-- Formatting -->
    <rule ref="PSR12">
        <!-- The codebase relies on long, descriptive lines in places (SQL, messages). -->
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>

    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <!-- Entry points and procedural hook files both declare functions and run code. -->
        <exclude-pattern>versionpress\.php</exclude-pattern>
        <exclude-pattern>bootstrap\.php</exclude-pattern>
        <exclude-pattern>setup-hooks\.php</exclude-pattern>
        <exclude-pattern>admin/*</exclude-pattern>
        <exclude-pattern>src/Api/VersionPressApi\.php</exclude-pattern>
        <exclude-pattern>src/Cli/vp*\.php</exclude-pattern>
    </rule>

    <!-- WordPress security, i18n and database best practices -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.Security.EscapeOutput">
        <!-- Terminal output of WP-CLI commands and the Git merge driver is not HTML. -->
        <exclude-pattern>/src/Cli/*</exclude-pattern>
        <exclude-pattern>/src/Git/merge-drivers/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="versionpress"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>

    <!-- PHP version compatibility -->
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
