<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="phpunit-bootstrap.php"
         cacheDirectory="../.phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnPhpunitDeprecations="true">
    <testsuites>
        <!-- Self-contained: no WordPress or database needed. -->
        <testsuite name="Unit">
            <directory>Unit</directory>
        </testsuite>
        <testsuite name="StorageTests">
            <directory>StorageTests</directory>
        </testsuite>
        <testsuite name="GitRepositoryTests">
            <directory>GitRepositoryTests</directory>
        </testsuite>

        <!--
            Need WordPress sites set up by WpAutomation in the isolated test environment
            (.wp-env.test.json); run them with `pnpm run test:wp`.
        -->
        <testsuite name="SynchronizerTests">
            <directory>SynchronizerTests</directory>
        </testsuite>
        <testsuite name="End2End">
            <directory>End2End</directory>
        </testsuite>
        <testsuite name="Workflow">
            <directory>Workflow</directory>
        </testsuite>
        <testsuite name="LoadTests">
            <directory>LoadTests</directory>
        </testsuite>
    </testsuites>
</phpunit>
