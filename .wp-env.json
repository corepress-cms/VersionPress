{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/latest.zip",
	"phpVersion": "8.5",
	"testsEnvironment": false,
	"plugins": [],
	"mappings": {
		"wp-content/plugins/versionpress": "./plugins/versionpress"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli sudo apk add --no-cache --quiet git"
	}
}
